{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic PPT VisualSpec v2.4",
  "type": "object",
  "required": [
    "visual_id", "visual_type", "scientific_role", "data_contract_id",
    "source_bindings", "row_filter", "aggregation", "entity_scope",
    "editability_requirement", "design_variant", "expected_row_count",
    "rendered_row_count", "expected_row_keys", "rendered_row_keys", "omitted_rows"
  ],
  "properties": {
    "visual_id": {"type": "string"},
    "visual_type": {"type": "string"},
    "scientific_role": {"type": "string"},
    "data_contract_id": {"type": "string"},
    "source_bindings": {"type": "array", "minItems": 1},
    "row_filter": {"type": "string"},
    "facet_filter": {"type": "string"},
    "aggregation": {"type": "string"},
    "entity_scope": {"type": "string"},
    "outcome": {"type": "string"},
    "estimand": {"type": "string"},
    "unit": {"type": "string"},
    "x_field": {"type": "string"},
    "y_field": {"type": "string"},
    "group_field": {"type": "string"},
    "facet_field": {"type": "string"},
    "color_field": {"type": "string"},
    "label_field": {"type": "string"},
    "ci_low_field": {"type": "string"},
    "ci_high_field": {"type": "string"},
    "reference_value": {},
    "time_field": {"type": "string"},
    "edge_source_field": {"type": "string"},
    "edge_target_field": {"type": "string"},
    "expected_row_count": {"type": "integer", "minimum": 0},
    "source_row_count": {"type": "integer", "minimum": 0},
    "rendered_row_count": {"type": ["integer", "null"], "minimum": 0},
    "expected_row_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rendered_row_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "top_k_policy": {"type": "string"},
    "omitted_rows": {"type": "array"},
    "editability_requirement": {"type": "string"},
    "design_variant": {"type": "string"}
  }
}
